{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./retcon_log_entry.schema.json",
  "title": "RetconLogEntry",
  "description": "Per-line schema for logs/retcons.jsonl entries.",
  "type": "object",
  "required": ["ts", "chapter_id", "reason", "impacted_entities", "approved_by"],
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "Retcon approval timestamp in ISO 8601 UTC."
    },
    "chapter_id": {
      "description": "Primary related chapter ID, or null when global.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^ch-[a-zA-Z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "description": "Reason for retcon and the conflict being resolved."
    },
    "impacted_entities": {
      "type": "array",
      "description": "Entities impacted by this retcon (characters, timeline items, rules).",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "changes": {
      "type": "array",
      "description": "List of concrete adjustments applied.",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "approved_by": {
      "type": "string",
      "description": "Approver identifier, usually author/editor."
    }
  },
  "additionalProperties": false
}
