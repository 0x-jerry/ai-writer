{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./status_history.schema.json",
  "title": "StatusHistoryIndex",
  "description": "Index of global status snapshots for cross-session resume and auditing.",
  "type": "object",
  "required": ["$schema", "entries"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Relative path to this schema file."
    },
    "entries": {
      "type": "array",
      "description": "Chronological status snapshot entries.",
      "items": {
        "type": "object",
        "description": "Single snapshot index record.",
        "required": ["ts", "snapshot_file", "chapter_id", "summary"],
        "properties": {
          "ts": {
            "type": "string",
            "format": "date-time",
            "description": "Snapshot creation time in ISO 8601 UTC."
          },
          "snapshot_file": {
            "type": "string",
            "description": "Path to snapshot markdown under status/history/."
          },
          "chapter_id": {
            "description": "Related chapter ID, or null when not tied to a chapter.",
            "anyOf": [
              {
                "type": "string",
                "pattern": "^ch-[a-zA-Z0-9_-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "type": "string",
            "description": "Short human-readable summary of status changes."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
